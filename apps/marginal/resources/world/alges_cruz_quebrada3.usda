    def Scope "mtl"
    {
        def Material "alges_cruz_quebrada_palette"
        {
            string inputs:alges_cruz_quebrada:texture:varname = "st"
            token outputs:surface.connect = </root/mtl/alges_cruz_quebrada_palette/alges_cruz_quebrada_surface.outputs:surface>

            def Shader "alges_cruz_quebrada_surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/mtl/alges_cruz_quebrada_palette/alges_cruz_quebrada_texture.outputs:rgb>
                float inputs:roughness = 1
                token outputs:displacement
                token outputs:surface
            }

            def Shader "alges_cruz_quebrada_texture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (0.5, 0.5, 0.5, 1)
                asset inputs:file = @../images/maya/palette.png@ (
                    colorSpace = "sRGB Encoded Rec.709 (sRGB)"
                )
                float2 inputs:st.connect = </root/mtl/alges_cruz_quebrada_palette/alges_cruz_quebrada_place2dTexture.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "alges_cruz_quebrada_place2dTexture"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname.connect = </root/mtl/alges_cruz_quebrada_palette.inputs:alges_cruz_quebrada:texture:varname>
                float2 outputs:result
            }
        }

        def Material "alges_cruz_quebrada_road"
        {
            string inputs:alges_cruz_quebrada:texture1:varname = "st"
            token outputs:surface.connect = </root/mtl/alges_cruz_quebrada_road/alges_cruz_quebrada_surface1.outputs:surface>

            def Shader "alges_cruz_quebrada_surface1"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/mtl/alges_cruz_quebrada_road/alges_cruz_quebrada_texture1.outputs:rgb>
                float inputs:roughness = 1
                token outputs:displacement
                token outputs:surface
            }

            def Shader "alges_cruz_quebrada_texture1"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (0.5, 0.5, 0.5, 1)
                asset inputs:file = @../images/road.png@ (
                    colorSpace = "sRGB Encoded Rec.709 (sRGB)"
                )
                float2 inputs:st.connect = </root/mtl/alges_cruz_quebrada_road/alges_cruz_quebrada_place2dTexture1_UsdTransform2d.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "alges_cruz_quebrada_place2dTexture1"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname.connect = </root/mtl/alges_cruz_quebrada_road.inputs:alges_cruz_quebrada:texture1:varname>
                float2 outputs:result
            }

            def Shader "alges_cruz_quebrada_place2dTexture1_UsdTransform2d"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/mtl/alges_cruz_quebrada_road/alges_cruz_quebrada_place2dTexture1.outputs:result>
                float inputs:rotation = 0
                float2 inputs:scale = (1, 8)
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }
        }
