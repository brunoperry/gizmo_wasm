#usda 1.0
(
    defaultPrim = "World"
    doc = "Avenida Marginal (EN6), Alges - Cruz Quebrada. Generated by apps/marginal/tools/build_world.mjs from OpenStreetMap data (c) OpenStreetMap contributors, ODbL."
